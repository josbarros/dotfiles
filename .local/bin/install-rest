#!/bin/bash

main () {
	pkg-update > /dev/null || { echo "pkg update failed!!!!!!" >&2; return 1; }
	STATUS=0	
	install_steam || STATUS=1
	install_vscode || STATUS=1
	install_misc || STATUS=1
	load_flathub || { echo "flathub load failed!!!!!"; return 1; }
	install_misc_flathub || STATUS=1
	install_betterbird || STATUS=1
	if (($STATUS)); then
		echo "Something went wrong!!!" >&2	
		return 1
	fi
	echo "SUCCESS!!!!!!"
}

install_steam () {
	if [ "$PCKMNG" = "apt" ]; then
		return
	fi
	sudo dnf config-manager setopt rpmfusion-nonfree-steam.enabled=1 && 
	sudo dnf install -y steam
}

install_vscode () {
	if [ "$PCKMNG" = "apt" ]; then
		return
	fi
	sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc &&
	echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\nautorefresh=1\ntype=rpm-md\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" | sudo tee /etc/yum.repos.d/vscode.repo > /dev/null &&
	sudo dnf install -y code
}

install_misc () {
	if [ "$PCKMNG" = "apt" ]; then
		return
	fi
	sudo "$PCKMNG" install -y nextcloud-client calibre mutter-devkit
}

load_flathub () {
	sudo "$PCKMNG" install -y flatpak &&
	flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo &&
	sudo flatpak remote-modify --enable flathub &&
	flatpak update --appstream > /dev/null
}

install_misc_flathub (){
	flatpak install -y flathub org.signal.Signal com.discordapp.Discord com.yubico.yubioath io.ente.photos com.brave.Browser com.bitwarden.desktop com.ktechpit.whatsie cc.arduino.IDE2
}

install_betterbird () {
	sudo "$PCKMNG" remove -y opensc && # gpg-scdaemon wants full access to SC so we remove this 
	if [ "$PCKMNG" = "dnf" ]; then
		sudo dnf install -y gnupg2-scdaemon
	elif [ "$PCKMNG" = "apt" ]; then
		sudo apt-get -y install scdaemon pcscd libccid
	fi &&
	flatpak install -y flathub eu.betterbird.Betterbird &&
	flatpak override --user --filesystem="$GNUPGHOME" eu.betterbird.Betterbird &&
	gpg --import "$XDG_DATA_HOME/public.asc"
}

main

