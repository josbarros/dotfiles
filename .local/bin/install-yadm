#!/bin/sh

main () {
	SSH_DIR="$HOME/.ssh"
   	SSH_KEY="$SSH_DIR/id_ed25519_sk_rk"
	install_yadm &&
	config_ssh &&
	config_repo &&
	gnupg_cleanup || { echo "Something failed!" >&2; return 1;}
	echo "Success! Please log off now to refresh .profile"
}

install_yadm () {
	echo "Installing yadm!"	
	# Add yadm repo before upgrading
	if [ -d /etc/dnf/ ]; then
	    sudo dnf config-manager addrepo --overwrite --from-repofile=https://download.opensuse.org/repositories/home:TheLocehiliosan:yadm/Fedora_42/home:TheLocehiliosan:yadm.repo 2> /dev/null &&
	    sudo dnf install -y yadm
	elif [ -d /etc/apt/ ]; then
	    sudo apt-get update > /dev/null && sudo apt-get install -y yadm
	else
	    echo "No supported package manager found" >&2
	    return 1
	fi
}

config_ssh () {
	echo "Configuring ssh!"	
	# Add ssh keys
	mkdir -p "$SSH_DIR" && 
	cd "$SSH_DIR" || return
	while true; do
	    if [ -e "$SSH_KEY" ] ; then
	        echo "Hardware SSH key is loaded!"
	        break
	    fi
	    echo "Waiting for the user to get an SSH key from an external hardware key"
	    ssh-keygen -K
	done
	cd - > /dev/null
}

config_repo () {
	echo "Cloning yadm repo!"	
	# Add ssh keys
	# Clone the dotfiles repo
	export GIT_SSH_COMMAND="ssh -o IdentityAgent=none -o IdentitiesOnly=yes -i \"$SSH_KEY\""
	if [ ! -d "$(yadm introspect repo)" ]; then
		yadm clone git@github.com:josbarros/dotfiles.git || return
	fi
	yadm gitconfig user.email "joserui@joseruibarros.com" &&
	yadm gitconfig user.name "José Rui Barros"
}

gnupg_cleanup () {
	# Finish off
	echo "Cleaning up gnupg!"	
	if [ -d ~/.gnupg ] ; then
	    DIR="$HOME/.local/share"
	    mkdir -p "$DIR" &&
	    mv ~/.gnupg "$DIR/gnupg"
	fi
}

main
