#!/bin/bash

main () {
	pkg-update > /dev/null || { echo "pkg update failed!!!!!!" >&2; return 1; }
	local MAIN_STATUS=0
    # load_wheel_scroll_hack	
	fix_mac_keyboard || MAIN_STATUS=1
	configure_user_dirs || MAIN_STATUS=1
	install_misc || MAIN_STATUS=1
	install_tlp || MAIN_STATUS=1
	install_gnome_exts || MAIN_STATUS=1
	configure_gnome || MAIN_STATUS=1
	if (($MAIN_STATUS)); then
		echo "Something went wrong!" >&2
		return 1
	fi
	echo "SUCCESS!!!!!!!!!!!"
}

load_wheel_scroll_hack () {
	echo "Applying the scroll wheel hack!"	
	sudo ln -s "$HOME/.local/bin/99-wheel-scroll-factor.lua" /etc/libinput/plugins/99-wheel-scroll-factor.lua 2> /dev/null
}

fix_mac_keyboard () {
	echo "Applying mac keyboard fix!"
	echo 'options hid_apple fnmode=1' | sudo tee /etc/modprobe.d/hid_apple.conf > /dev/null
}

configure_user_dirs () {
	echo "Configuring user dirs!"
	# Set base dirs to english 
	rm -f "$XDG_CONFIG_HOME/user-dirs.dirs" &&
	LANGUAGE=en LC_ALL=en_US.UTF-8 xdg-user-dirs-update &&
	# Avoid annoying popup at boot
	echo 'pt_PT' > "$XDG_CONFIG_HOME/user-dirs.locale"
}

install_misc () {
	echo "Installing misc crap!"
	sudo "$PCKMNG" install -y powertop gnome-tweaks gnome-extensions-app guvcview &&
	# TODO Ver maneira de ja esta calibrado ou nao, ou se isso e' sequer preciso
	# sudo powertop -c # calibrate
	# Install on the old thinkpad to confirm video HW accelation on FF
	if [ "$PCKMNG" = "apt-get" ]; then
	    sudo apt-get install -y intel-gpu-tools
	fi
}

install_tlp () {
	echo "Installing tlp!"
	# Install tlp
	sudo "$PCKMNG" install -y tlp tlp-rdw &&
	if [ "$PCKMNG" = "dnf" ]; then
		# not available right now on debian
	    sudo dnf install -y tlp-pd
	fi &&
	sudo "$PCKMNG" remove -y tuned tuned-ppd &&
	if ps -p 1 | grep -q "systemd"; then
	    sudo systemctl enable tlp.service tlp-pd.service &&
	    sudo systemctl mask systemd-rfkill.service systemd-rfkill.socket > /dev/null
	fi
}

install_gnome_exts () {
	exts=("accent-directories@taiwbi.com" "appindicatorsupport@rgcjonas.gmail.com" "auto-accent-colour@Wartybix" "caffeine@patapon.info" "drive-menu@gnome-shell-extensions.gcampax.github.com" "marcs14@gmail.com" "clipboard-indicator@tudmotu.com" "power-switching-manager@joseruibarros.com" "executor@raujonas.github.io")
	echo "Installing gnome extensions!"
	sudo "$PCKMNG" install -y pipx &&
	# Install gnome extensions - marcs14 is the power manager
	pipx install gnome-extensions-cli > /dev/null &&
	gext install "${exts[@]}" &&
	gext enable "${exts[@]}"
}

configure_gnome () {
	echo "Configuring gnome!"
	local STATUS=0
	# Move window buttons to the left, like MacOS
	gsettings set org.gnome.desktop.wm.preferences button-layout "close:appmenu" || STATUS=$?
	# Swap esc and caps, use right Super as AltGr, keypad as four-level key with dot - this resets all other keyboard settings, careful!
	gsettings set org.gnome.desktop.input-sources xkb-options "['caps:swapescape','lv3:rwin_switch','kpdl:dotoss']" || STATUS=$?
	# Set location and night light
	gsettings set org.gnome.system.location enabled true || STATUS=$?
	gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled true || STATUS=$?
	gsettings set org.gnome.settings-daemon.plugins.color night-light-schedule-automatic true || STATUS=$?
	# Set automatic date time and time zone
	# TODO add automatic date and time
	gsettings set org.gnome.desktop.datetime automatic-timezone true || STATUS=$?
	# Show battery percentage
	gsettings set org.gnome.desktop.interface show-battery-percentage true || STATUS=$?
	return $STATUS
}

main
